{
  "name": "lia-kachel",
  "version": "0.7.0",
  "private": true,
  "description": "Native LiaScript tiles with touch drag-and-drop, grouped table sequences and LiaScript-owned grading",
  "app": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "parcel build src/index.ts --target app --no-scope-hoist",
    "test:unit": "node --test tests/content.test.mjs tests/distribution.test.mjs tests/groups.test.mjs tests/kachelfolge.test.mjs",
    "test:browser": "node --test tests/browser/kachelfolge-browser.test.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "targets": {
    "app": {
      "context": "browser",
      "engines": {
        "browsers": [
          "defaults",
          "Safari >= 12",
          "iOS >= 12"
        ]
      },
      "outputFormat": "global",
      "sourceMap": false
    }
  },
  "devDependencies": {
    "@liascript/devserver": "1.2.10--1.1.0",
    "@parcel/transformer-inline-string": "2.16.4",
    "parcel": "2.16.4",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  }
}
